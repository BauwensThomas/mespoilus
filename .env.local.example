# Anthropic API
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Security
CSRF_SECRET=votre-secret-csrf-aleatoire-tres-long-au-moins-32-chars
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Unsplash (gratuit - 50 req/heure)
# Crée un compte sur https://unsplash.com/developers puis une app
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# Resend (newsletter) — gratuit jusqu'à 3000 emails/mois
# Créer un compte sur https://resend.com puis générer une API key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Awin
AWIN_PUBLISHER_ID=xxxxxxxxxxxxxxxxxxxxxxxxx
AWIN_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cron (sécurise les routes /api/cron/* sur Vercel)
CRON_SECRET=votre-secret-cron-aleatoire-tres-long-au-moins-32-chars

# Buffer (publication automatique réseaux sociaux par Emma)
# Créer un compte sur https://buffer.com → Settings → Apps → Create App → Access Token
BUFFER_ACCESS_TOKEN=your_buffer_access_token

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
